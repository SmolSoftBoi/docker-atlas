# Keep the UI on loopback. Use SSH forwarding or a secured reverse proxy remotely.
BIND_ADDRESS=127.0.0.1
UPTIME_KUMA_PORT=3001

# Dedicated local directory mounted directly at /app/data; no subdirectory is added.
# Use storage with reliable POSIX file locking, not an NFS share.
# Follow README setup to restrict this directory to its owner before starting.
DATA_ROOT=./data

TZ=Europe/London
