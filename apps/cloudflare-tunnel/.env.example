# Select bridge, host, or both as a comma-separated list: bridge,host
COMPOSE_PROFILES=bridge

# Set only the tokens required by the selected profiles.
# When both profiles are active, use tokens for two different Cloudflare tunnels.
TUNNEL_TOKEN_BRIDGE=
TUNNEL_TOKEN_HOST=

# Docker hostnames identify the connector containers; tokens select the tunnels.
TUNNEL_HOSTNAME_BRIDGE=cloudflare-tunnel-bridge
TUNNEL_HOSTNAME_HOST=cloudflare-tunnel-host

# Keep metrics on loopback unless you have secured an alternative listener.
METRICS_ADDRESS=127.0.0.1:20241
